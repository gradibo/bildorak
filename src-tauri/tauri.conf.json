{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "빌도락",
  "version": "0.1.0",
  "identifier": "com.gradibo.bildorak",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "빌도락",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyNjgxRTYwMzY5QTQwNDkKUldSSlFKbzJZQjVvY3NEMEkrdUFDeWU4OURSNG9OVnZiK2hMbW4yN1dQNHdaNTNhSlJOdW0xc0MK",
      "endpoints": [
        "https://github.com/gradibo/bildorak/releases/latest/download/latest.json"
      ]
    }
  }
}
